# Copier ce fichier en .env puis remplir les valeurs. NE JAMAIS committer .env.

# URL RPC Sepolia (Alchemy, Infura, QuickNode...)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/VOTRE_CLE

# Clé privée du déployeur (= le client de l'escrow). Utiliser un wallet de test dédié.
PRIVATE_KEY=0xvotre_cle_privee_de_test

# Adresses des deux autres rôles (obligatoires pour un déploiement sur Sepolia)
FREELANCER_ADDRESS=0x0000000000000000000000000000000000000000
ARBITER_ADDRESS=0x0000000000000000000000000000000000000000

# Durée avant la deadline, en jours (défaut : 14)
DEADLINE_DAYS=14
